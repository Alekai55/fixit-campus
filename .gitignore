# ------------------------------------------------------------------------------
# 4. Android (android-app)
# ------------------------------------------------------------------------------
# Gradle y compilación
.gradle/
**/build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
output-metadata.json

# Archivos de configuración local (rutas del SDK local del desarrollador)
local.properties

# Paquetes y ejecutables generados
*.apk
*.aab

# Firmas y certificados (seguridad)
*.jks
*.keystore

# Servicios de Google / Firebase locales
google-services.json

# Profiling
*.hprof

# ------------------------------------------------------------------------------
# 5. Java / Backend (backend)
# ------------------------------------------------------------------------------
# Maven
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Logs generados por la aplicación
*.log
archivos-log/
**/archivos-log/

# Archivos y carpetas generados específicamente por la lógica de Backend Java
archivos_creados/
**/archivos_creados/

